NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact public origin; use this local URL during development.
SITE_URL=http://127.0.0.1:3000
# Server-side only. Do not prefix either key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
MOLLIE_API_KEY=
# At least 32 random characters. Used only to authenticate the webhook URL.
MOLLIE_WEBHOOK_SECRET=
# Public HTTPS origin reachable by Mollie, e.g. https://example.com
MOLLIE_WEBHOOK_BASE_URL=
MOLLIE_TERMS_URL=
MOLLIE_PRIVACY_URL=
# Leave false until migrations, legal pages, Mollie profile and webhook are verified.
BILLING_ENABLED=false
# Separate BRL/PayPal launch switch. Enable only after the BRL migration and
# both first and recurring PayPal methods are approved and tested in Mollie.
MOLLIE_BRL_ENABLED=false
